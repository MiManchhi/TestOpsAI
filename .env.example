# Local Docker infrastructure only. setup.ps1 creates random credentials in .env.
MYSQL_DATABASE=testops
MYSQL_USER=testops
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
QDRANT_API_KEY=

# Compatible chat API base, including the provider's version prefix (for example /v1).
TESTOPS_AI_CHAT_BASE_URL=
TESTOPS_AI_CHAT_MODEL=
TESTOPS_AI_CHAT_API_KEY=
# Full embeddings endpoint, model ID and actual output dimension.
TESTOPS_AI_EMBEDDING_URL=
TESTOPS_AI_EMBEDDING_MODEL=
TESTOPS_AI_EMBEDDING_DIMENSIONS=0
TESTOPS_AI_EMBEDDING_API_KEY=
