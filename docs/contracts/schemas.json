{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://testopsai.local/contracts/1.0.0/schemas.json",
  "title": "TestOps AI cross-service DTOs 1.0.0",
  "definitions": {
    "Id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "requestId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "required": ["code", "message", "requestId"],
      "additionalProperties": false
    },
    "LoginRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "password": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": ["username", "password"],
      "additionalProperties": false
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "maxLength": 4096
        },
        "expiresIn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["accessToken", "expiresIn"],
      "additionalProperties": false
    },
    "CurrentUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "username": {
          "type": "string",
          "maxLength": 64
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 100
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": ["id", "username", "roles", "createdAt"],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "$ref": "#/definitions/Sha256"
        }
      },
      "required": ["path", "line", "revision"],
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "maxLength": 256
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 50
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["keyword", "arguments", "line"],
      "additionalProperties": false
    },
    "ImportIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "sourcePath": {
          "type": "string",
          "maxLength": 512
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": ["code", "sourcePath", "line", "message"],
      "additionalProperties": false
    },
    "RunCounts": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["total", "pass", "fail", "skip"],
      "additionalProperties": false
    },
    "AuthorizedScope": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "./schemas.json#/definitions/Id"
        },
        "actorId": {
          "$ref": "./schemas.json#/definitions/Id"
        },
        "knowledgeBaseIds": {
          "type": "array",
          "items": {
            "$ref": "./schemas.json#/definitions/Id"
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "documentIds": {
          "type": "array",
          "items": {
            "$ref": "./schemas.json#/definitions/Id"
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "caseIds": {
          "type": "array",
          "items": {
            "$ref": "./schemas.json#/definitions/Id"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "runIds": {
          "type": "array",
          "items": {
            "$ref": "./schemas.json#/definitions/Id"
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "search_test_cases",
              "get_test_case_detail",
              "get_run_summary",
              "get_failed_cases",
              "search_knowledge",
              "create_case_draft"
            ]
          },
          "maxItems": 6
        },
        "expiresAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "caseScope": {
          "type": "string",
          "enum": ["PROJECT", "SELECTION"]
        }
      },
      "required": [
        "projectId",
        "actorId",
        "knowledgeBaseIds",
        "documentIds",
        "caseIds",
        "runIds",
        "allowedTools",
        "expiresAt",
        "caseScope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "caseScope": {
                "const": "PROJECT"
              }
            }
          },
          "then": {
            "properties": {
              "caseIds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "objectId": {
          "$ref": "#/definitions/Uuid"
        },
        "sha256": {
          "$ref": "#/definitions/Sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "logicalPath": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
        }
      },
      "required": ["objectId", "sha256", "sizeBytes", "logicalPath"],
      "additionalProperties": false
    },
    "ParsedSuite": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "parentPath": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["path", "name", "parentPath"],
      "additionalProperties": false
    },
    "ParsedCase": {
      "type": "object",
      "properties": {
        "suitePath": {
          "type": "string",
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "documentation": {
          "type": "string",
          "maxLength": 10000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 30
        },
        "source": {
          "$ref": "#/definitions/SourceRef"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Step"
          },
          "maxItems": 500
        }
      },
      "required": ["suitePath", "name", "documentation", "tags", "source", "steps"],
      "additionalProperties": false
    },
    "RobotParseResult": {
      "type": "object",
      "properties": {
        "suites": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParsedSuite"
          },
          "maxItems": 1000
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParsedCase"
          },
          "maxItems": 10000
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportIssue"
          },
          "maxItems": 1000
        }
      },
      "required": ["suites", "cases", "issues"],
      "additionalProperties": false
    },
    "ResultParseRequest": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/definitions/Uuid"
        },
        "object": {
          "$ref": "#/definitions/ObjectRef"
        }
      },
      "required": ["operationId", "object"],
      "additionalProperties": false
    },
    "ParsedResult": {
      "type": "object",
      "properties": {
        "suitePath": {
          "type": "string",
          "maxLength": 512
        },
        "caseName": {
          "type": "string",
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIP"]
        },
        "message": {
          "type": "string",
          "maxLength": 10000
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "failedKeyword": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["suitePath", "caseName", "status", "message", "elapsedMs", "failedKeyword"],
      "additionalProperties": false
    },
    "ResultParseResult": {
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/definitions/RunCounts"
        },
        "startedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParsedResult"
          },
          "maxItems": 10000
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportIssue"
          },
          "maxItems": 1000
        }
      },
      "required": ["counts", "startedAt", "finishedAt", "results", "issues"],
      "additionalProperties": false
    },
    "IndexRequest": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/definitions/Uuid"
        },
        "documentId": {
          "$ref": "./schemas.json#/definitions/Id"
        },
        "knowledgeBaseId": {
          "$ref": "./schemas.json#/definitions/Id"
        },
        "contentHash": {
          "$ref": "#/definitions/Sha256"
        },
        "object": {
          "$ref": "#/definitions/ObjectRef"
        },
        "parserVersion": {
          "type": "string",
          "maxLength": 64
        },
        "embeddingProfile": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "operationId",
        "documentId",
        "knowledgeBaseId",
        "contentHash",
        "object",
        "parserVersion",
        "embeddingProfile"
      ],
      "additionalProperties": false
    },
    "IndexJob": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Uuid"
        },
        "operationId": {
          "$ref": "#/definitions/Uuid"
        },
        "status": {
          "type": "string",
          "enum": ["QUEUED", "PROCESSING", "SUCCEEDED", "FAILED", "CANCELLED"]
        },
        "stage": {
          "type": "string",
          "enum": ["PARSING", "CHUNKING", "EMBEDDING", "CLEANUP", "FINISHED"]
        },
        "chunkCount": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["id", "operationId", "status", "stage", "chunkCount", "error"],
      "additionalProperties": false
    },
    "IndexDelete": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/definitions/Uuid"
        },
        "documentId": {
          "$ref": "./schemas.json#/definitions/Id"
        },
        "contentHash": {
          "$ref": "#/definitions/Sha256"
        }
      },
      "required": ["operationId", "documentId", "contentHash"],
      "additionalProperties": false
    },
    "ServiceClaims": {
      "type": "object",
      "properties": {
        "iss": {
          "type": "string",
          "enum": ["testops-server", "testops-ai"]
        },
        "aud": {
          "type": "string",
          "enum": ["testops-ai", "testops-server-tools"]
        },
        "iat": {
          "type": "integer",
          "minimum": 0
        },
        "exp": {
          "type": "integer",
          "minimum": 0
        },
        "jti": {
          "$ref": "#/definitions/Uuid"
        },
        "operationId": {
          "$ref": "#/definitions/Uuid"
        }
      },
      "required": ["iss", "aud", "iat", "exp", "jti", "operationId"],
      "additionalProperties": false
    },
    "DelegationClaims": {
      "type": "object",
      "properties": {
        "iss": {
          "const": "testops-server"
        },
        "aud": {
          "const": "testops-server-tools"
        },
        "iat": {
          "type": "integer",
          "minimum": 0
        },
        "exp": {
          "type": "integer",
          "minimum": 0
        },
        "jti": {
          "$ref": "#/definitions/Uuid"
        },
        "operationId": {
          "$ref": "#/definitions/Uuid"
        },
        "actorId": {
          "$ref": "#/definitions/Id"
        },
        "projectId": {
          "$ref": "#/definitions/Id"
        },
        "scope": {
          "$ref": "#/definitions/AuthorizedScope"
        },
        "objectIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Uuid"
          },
          "maxItems": 200,
          "uniqueItems": true
        },
        "authorizationVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "iss",
        "aud",
        "iat",
        "exp",
        "jti",
        "operationId",
        "actorId",
        "projectId",
        "scope",
        "objectIds",
        "authorizationVersion"
      ],
      "additionalProperties": false
    }
  }
}
