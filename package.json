{
  "name": "testops-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @testops/web",
    "build": "npm run build --workspace @testops/web",
    "check": "npm run contracts:check && npm run check --workspace @testops/web",
    "contracts:check": "node tests/contracts/check.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "ajv": "6.15.0",
    "prettier": "3.10.1"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "printWidth": 100
  },
  "packageManager": "npm@11.6.4"
}
